{
  "name": "@efs/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for the Ethereum File System (EFS)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efs-project/sdk.git",
    "directory": "packages/sdk"
  },
  "files": ["dist"],
  "publishConfig": { "access": "public", "provenance": true },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./eas": {
      "import": {
        "types": "./dist/eas/index.d.ts",
        "default": "./dist/eas/index.js"
      },
      "require": {
        "types": "./dist/eas/index.d.cts",
        "default": "./dist/eas/index.cjs"
      }
    },
    "./lenses": {
      "import": {
        "types": "./dist/lenses/index.d.ts",
        "default": "./dist/lenses/index.js"
      },
      "require": {
        "types": "./dist/lenses/index.d.cts",
        "default": "./dist/lenses/index.cjs"
      }
    },
    "./chain": {
      "import": {
        "types": "./dist/chain/index.d.ts",
        "default": "./dist/chain/index.js"
      },
      "require": {
        "types": "./dist/chain/index.d.cts",
        "default": "./dist/chain/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "peerDependenciesMeta": {
    "viem": { "optional": false }
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "viem": "^2.21.0",
    "vitest": "^2.1.0",
    "prool": "^0.0.16"
  }
}
