{
  "name": "@efs/solidity",
  "version": "0.0.0",
  "description": "On-chain (Solidity) SDK for the Ethereum File System (EFS) \u2014 a compile-in library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efs-project/sdk.git",
    "directory": "packages/solidity"
  },
  "files": ["src/**/*.sol", "vendor/**/*.sol", "remappings.txt", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./src/v1/*.sol": "./src/v1/*.sol",
    "./package.json": "./package.json"
  },
  "keywords": ["ethereum", "efs", "eas", "solidity", "filesystem"],
  "homepage": "https://github.com/efs-project/sdk/tree/main/packages/solidity",
  "dependencies": {
    "@ethereum-attestation-service/eas-contracts": "1.7.1"
  },
  "scripts": {
    "setup": "[ -d lib/forge-std ] || git clone --depth 1 --branch v1.9.4 https://github.com/foundry-rs/forge-std lib/forge-std",
    "prebuild": "pnpm run setup",
    "pretest": "pnpm run setup",
    "build": "forge build",
    "test": "forge test",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check"
  }
}
