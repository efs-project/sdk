{
  "name": "@efs/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "The Ethereum File System SDK — TypeScript and Solidity",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/efs-project/sdk.git"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.9",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
